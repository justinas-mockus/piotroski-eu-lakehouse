{
  "datasets": [
    {
      "catalog": "piotroski_dev",
      "displayName": "score_distribution",
      "name": "fec5385a",
      "queryLines": [
        "SELECT lei, fiscal_year, f_score, signals_available\n",
        "FROM piotroski_score\n",
        "QUALIFY row_number() OVER (PARTITION BY lei ORDER BY fiscal_year DESC) = 1\n"
      ],
      "schema": "gold"
    },
    {
      "catalog": "piotroski_dev",
      "displayName": "top_20",
      "name": "b234ceb7",
      "queryLines": [
        "SELECT listings[0].name   AS company,\n",
        "       listings[0].ticker AS ticker,\n",
        "       lei, fiscal_year, f_score, data_completeness\n",
        "FROM piotroski_score\n",
        "WHERE signals_available = 9\n",
        "QUALIFY row_number() OVER (PARTITION BY lei ORDER BY fiscal_year DESC) = 1\n",
        "ORDER BY f_score DESC, company\n",
        "LIMIT 20\n"
      ],
      "schema": "gold"
    },
    {
      "catalog": "piotroski_dev",
      "displayName": "dq_over_runs",
      "name": "00e7c70c",
      "queryLines": [
        "SELECT run_id, min(computed_at) AS run_at, rule, failed, checked, pct_failed\n",
        "FROM dq_results_history\n",
        "GROUP BY run_id, rule, failed, checked, pct_failed\n"
      ],
      "schema": "gold"
    }
  ],
